// Cloudflare Workers (ADR-010). Todo el sitio es estático salvo Notes, que se lee de D1 (ADR-011)
// y sirve sus PDF desde R2 (ADR-012).
// El adaptador @astrojs/cloudflare añade al build el Worker (main) y los assets estáticos.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabellos-research-group",
  "compatibility_date": "2026-09-01",
  // Entrada propia (ADR-016): redirige *.workers.dev al dominio y luego llama al manejador de Astro.
  "main": "./src/worker.ts",
  // run_worker_first: toda petición, también la de páginas estáticas, entra primero al Worker
  // (si no, workers.dev serviría el HTML sin pasar por la redirección). El binding ASSETS es el
  // que usa el adaptador; al declararlo aquí, el adaptador ya no lo agrega por su cuenta.
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  // Dominio propio (zona activa en la misma cuenta). Cloudflare crea el registro DNS y el certificado.
  // www NO va aquí: es un registro DNS AAAA 100:: con proxy y una Redirect Rule de la zona lo manda
  // a la raíz (con www como dominio del Worker, la regla no se aplica).
  "routes": [
    { "pattern": "cabellosresearchgroup.org", "custom_domain": true }
  ],
  // La dirección *.workers.dev sigue activa solo para redirigir (301) al dominio propio (ADR-016).
  // Cuando el buscador ya muestre cabellosresearchgroup.org, se puede poner en false.
  "workers_dev": true,
  "vars": {
    // "true" muestra las notas de prueba (is_test = 1). En producción va en "false" (desde 2026-10-10).
    "SHOW_TEST_NOTES": "false",
    // Panel /admin (ADR-013). Sin ACCESS_TEAM_DOMAIN y ACCESS_AUD el panel responde 503 (cerrado).
    // Dominio del equipo de Zero Trust, p. ej. "https://<equipo>.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "https://cabellos.cloudflareaccess.com",
    // Etiqueta "Application Audience (AUD)" de la aplicación de Access del panel.
    "ACCESS_AUD": "f3297e8de08da91d3d32c889da81d04e63b64e2b5db508827963cec010a80a2f"
    // Los correos con permiso se administran solo en Zero Trust → Policies → «Correos del panel».
    // Opcional: "ADMIN_EMAILS": "a@x.com,b@y.com" restringe además a esos correos (ADR-013).
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cabellos-notes",
      // Lo reemplaza scripts/cf-setup-d1.mjs con el id real de la base remota.
      "database_id": "4199cb18-8d71-4ba9-b3d5-31503613b8e3",
      "migrations_dir": "migrations"
    }
  ],
  // Archivos de Notes (PDF). El bucket no es público: el Worker los sirve en /files/… (ADR-012).
  "r2_buckets": [
    { "binding": "NOTES_FILES", "bucket_name": "cabellos-research-files" }
  ]
}
