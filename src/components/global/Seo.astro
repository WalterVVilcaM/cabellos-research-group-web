---
/** Metadatos de cabecera: title, description, canonical, hreflang, Open Graph. */
import { site } from '../../config/site';
import { useTranslations, withBase, type Lang, type Alternates } from '../../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates?: Alternates;
  noindex?: boolean;
  ogType?: 'website' | 'profile' | 'article';
  /** Ruta canónica si no es la propia página (notas vistas con la otra interfaz; ADR-009). */
  canonicalPath?: string;
  /** Alternos para hreflang si difieren de `alternates`; `null` = no declarar hreflang. */
  hreflang?: Alternates | null;
  /** og:locale si difiere del idioma de la interfaz (idioma de la nota). */
  ogLocale?: string;
  /** Datos estructurados JSON-LD. */
  jsonLd?: Record<string, unknown>;
}
const {
  lang,
  title,
  description,
  alternates,
  noindex = false,
  ogType = 'website',
  canonicalPath,
  hreflang,
  ogLocale,
  jsonLd,
} = Astro.props;
const hreflangAlternates = hreflang === undefined ? alternates : hreflang;
const t = useTranslations(lang);
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base).href;
// Buscadores: título ≤ 70 caracteres y descripción ≤ 160 (Bing marca error si se pasan).
// Si el título con la marca es muy largo, va solo; si ya empieza con la marca (inicio), se respeta.
const withBrand = `${title} · ${site.brand}`;
const fullTitle =
  title === site.brand || title.startsWith(`${site.brand} ·`) || withBrand.length > 70 ? title : withBrand;
// Al recortar no se deja colgando una palabra cortada ni un artículo o preposición.
const DANGLING = /[\s,;:]+(?:de|del|la|las|el|los|y|e|o|a|al|en|con|para|por|que|the|of|and|or|to|in|on|for|with|a|an)$/i;
const metaDescription =
  description.length <= 160
    ? description
    : `${description.slice(0, 158).replace(/[\s,;:]+\S*$/, '').replace(DANGLING, '').replace(DANGLING, '')}…`;
const ogImage = new URL(withBase('/og-image.png'), base).href;
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex && hreflangAlternates && (
    <>
      <link rel="alternate" hreflang="en" href={new URL(hreflangAlternates.en, base).href} />
      <link rel="alternate" hreflang="es" href={new URL(hreflangAlternates.es, base).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(hreflangAlternates.en, base).href} />
    </>
  )
}
<meta property="og:site_name" content={site.brand} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale ?? t('meta.ogLocale')} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
