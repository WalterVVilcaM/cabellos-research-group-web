---
/** Monograma del grupo: clúster de cuatro átomos (tetraedro en proyección). Decorativo. */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="mark">
  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <line x1="9" y1="22" x2="23" y2="22"></line>
    <line x1="9" y1="22" x2="16" y2="9"></line>
    <line x1="23" y1="22" x2="16" y2="9"></line>
    <line x1="16" y1="9" x2="17.5" y2="18"></line>
    <line x1="9" y1="22" x2="17.5" y2="18"></line>
    <line x1="23" y1="22" x2="17.5" y2="18"></line>
  </g>
  <circle cx="16" cy="9" r="4" fill="var(--mark-accent, #3f9a72)"></circle>
  <circle cx="9" cy="22" r="3.4" fill="currentColor"></circle>
  <circle cx="23" cy="22" r="3.4" fill="currentColor"></circle>
  <circle cx="17.5" cy="18" r="2.4" fill="var(--color-bg, #f7f6f2)" stroke="currentColor" stroke-width="1.6"></circle>
</svg>
