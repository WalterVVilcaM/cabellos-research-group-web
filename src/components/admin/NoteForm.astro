---
/**
 * Editor de notas del panel (NOTES-F5, ADR-014; rediseño 2026-09-30).
 * Pasos guiados con indicaciones a la izquierda y vista previa en vivo de la nota completa a la derecha
 * (en pantallas angostas se alterna "Editar / Vista previa"). El Markdown de la vista previa usa el mismo
 * conversor que el sitio (src/utils/markdown.ts), así lo que se ve es lo que se publica.
 * Sin JavaScript todo sigue funcionando: se escribe Markdown y se guarda.
 */
import { noteCategories, noteCategoryIds } from '../../config/notes';
import { notePath, useTranslations } from '../../i18n/utils';
import { formatBytes } from '../../utils/notes';
import { LINK_KINDS, slugify, type FieldErrors, type NoteDraft } from '../../utils/admin-notes';
import { RIGHTS } from '../../utils/storage';

interface Props {
  draft: NoteDraft;
  errors: FieldErrors;
  research: { id: string; label: string; labelEn: string }[];
  authors: { id: string; label: string }[];
}
const { draft: d, errors, research, authors } = Astro.props;
const tEs = useTranslations('es');
const tEn = useTranslations('en');
const isPublished = d.status === 'published';
const err = (k: string) => errors[k];
const hasErrors = Object.keys(errors).length > 0;

const rightsLabels: Record<(typeof RIGHTS)[number], string> = {
  author: 'Es material propio (del Dr. Cabellos o del grupo)',
  'open-access': 'Es de acceso abierto (su licencia permite compartirlo)',
  'public-domain': 'Es de dominio público',
  permission: 'Tenemos permiso del autor o de la editorial',
};
const rightsOrder = ['author', 'open-access', 'public-domain', 'permission'] as const;

const links = d.links.length > 0 ? d.links : [{ title: '', url: '', kind: 'other' as const, description: '' }];
const host = Astro.url.host;
const prefixes = { es: notePath('x', 'es').slice(0, -2), en: notePath('x', 'en').slice(0, -2) };
// La dirección sigue al título mientras no se haya escrito a mano.
const slugAuto = !isPublished && (!d.slug || d.slug === slugify(d.title));
const advancedErrors = ['authorId', 'publishedAt', 'revisedAt', 'tags'].some((k) => err(k));
const singleAuthor = authors.length === 1 ? authors[0] : undefined;

// A qué campo lleva cada error del resumen.
const errorTargets: Record<string, string> = {
  title: 'title',
  slug: 'slug',
  summary: 'summary',
  category: 'cat-opinion',
  content: 'content',
  links: 'links-title',
  new_file: 'new_file',
  authorId: 'authorId',
  publishedAt: 'publishedAt',
  revisedAt: 'revisedAt',
  tags: 'tags',
};

// Datos para la vista previa en vivo (textos de la página pública en ambos idiomas).
const kinds = Object.fromEntries(LINK_KINDS.map((k) => [k, { es: tEs(`notes.kind.${k}`), en: tEn(`notes.kind.${k}`) }]));
const previewConfig = {
  host,
  prefixes,
  authors: Object.fromEntries(authors.map((a) => [a.id, a.label])),
  research: Object.fromEntries(research.map((r) => [r.id, { es: r.label, en: r.labelEn }])),
  categories: Object.fromEntries(noteCategoryIds.map((c) => [c, noteCategories[c].name])),
  kinds,
  labels: {
    es: {
      links: tEs('notes.links'),
      files: tEs('notes.files'),
      tags: tEs('notes.tags'),
      research: tEs('notes.research'),
      updated: tEs('notes.updated', { date: '' }).trim(),
      open: tEs('notes.open'),
      download: tEs('notes.download'),
    },
    en: {
      links: tEn('notes.links'),
      files: tEn('notes.files'),
      tags: tEn('notes.tags'),
      research: tEn('notes.research'),
      updated: tEn('notes.updated', { date: '' }).trim(),
      open: tEn('notes.open'),
      download: tEn('notes.download'),
    },
  },
  attachments: d.attachments.map((a) => ({ id: a.id, title: a.title, sizeBytes: a.sizeBytes })),
  isTest: d.isTest,
};
---

<div class="workspace" data-workspace data-view="edit">
  <div class="view-switch" role="group" aria-label="Modo" data-view-switch hidden>
    <button type="button" data-view-btn="edit" aria-pressed="true">Editar</button>
    <button type="button" data-view-btn="preview" aria-pressed="false">Vista previa</button>
  </div>

  <form method="post" enctype="multipart/form-data" class="note-form" novalidate data-note-form>
    {
      hasErrors && (
        <div class="admin-flash admin-flash--error" role="alert" tabindex="-1" data-error-summary>
          <strong>Falta corregir algo antes de guardar:</strong>
          <ul>
            {Object.entries(errors).map(([k, m]) => (
              <li>
                <a href={`#${errorTargets[k] ?? 'title'}`}>{m}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- 1. Tipo de nota -->
    <section class="step admin-card" aria-labelledby="step1">
      <h2 id="step1" class="step__title"><span class="step__n" aria-hidden="true">1</span> Tipo de nota</h2>

      <fieldset class="field">
        <legend>¿En qué idioma escribes la nota?</legend>
        <div class="pills">
          <label class="pill">
            <input type="radio" name="lang" value="es" checked={d.lang === 'es'} data-lang />
            <span>Español</span>
          </label>
          <label class="pill">
            <input type="radio" name="lang" value="en" checked={d.lang === 'en'} data-lang />
            <span>Inglés (English)</span>
          </label>
        </div>
        <p class="field__help">La nota se publica tal cual en ese idioma; no se traduce automáticamente.</p>
      </fieldset>

      <fieldset class="field">
        <legend>¿Qué tipo de nota es?</legend>
        <div class="cards">
          {
            noteCategoryIds.map((c) => (
              <label class="choice">
                <input type="radio" id={`cat-${c}`} name="category" value={c} checked={d.category === c} data-category />
                <span class="choice__name">{noteCategories[c].name.es}</span>
                <span class="choice__desc">{noteCategories[c].description.es}</span>
              </label>
            ))
          }
        </div>
        {err('category') && <p class="field__error">{err('category')}</p>}
      </fieldset>
    </section>

    <!-- 2. Título y resumen -->
    <section class="step admin-card" aria-labelledby="step2">
      <h2 id="step2" class="step__title"><span class="step__n" aria-hidden="true">2</span> Título y resumen</h2>

      <div class="field">
        <label for="title">Título</label>
        <input
          id="title"
          name="title"
          value={d.title}
          required
          maxlength="200"
          placeholder="Por ejemplo: Tres lecturas sobre química computacional"
          aria-describedby="title-help"
          aria-invalid={err('title') ? 'true' : undefined}
          data-title
        />
        <p id="title-help" class="field__help">Se muestra grande arriba de la nota y en el listado de notas.</p>
        {err('title') && <p class="field__error">{err('title')}</p>}
      </div>

      <div class="field">
        <span class="field__label" id="url-label">Dirección de la nota</span>
        <p class="url" data-url-line hidden>
          <span class="url__text">
            <span class="url__base" data-url-base>{host}{prefixes[d.lang]}</span><strong data-url-slug>{d.slug || '…'}</strong>/
          </span>
          {!isPublished && (
            <button type="button" class="link-btn" data-url-edit aria-controls="slug-box">
              Cambiar
            </button>
          )}
        </p>
        <div class="slug" id="slug-box" data-slug-box>
          <span class="slug__prefix" aria-hidden="true" data-slug-prefix>{prefixes[d.lang]}</span>
          <input
            id="slug"
            name="slug"
            value={d.slug}
            maxlength="80"
            readonly={isPublished}
            placeholder="se-crea-sola-con-el-titulo"
            aria-labelledby="url-label"
            aria-describedby="slug-help"
            aria-invalid={err('slug') ? 'true' : undefined}
            data-slug
          />
        </div>
        <input type="hidden" name="slug_auto" value={slugAuto ? 'true' : 'false'} data-slug-auto />
        <p id="slug-help" class="field__help">
          {
            isPublished
              ? 'La nota ya está publicada: su dirección no cambia, para no romper los enlaces que ya se hayan compartido.'
              : 'Se crea sola a partir del título; no necesitas hacer nada. Si quieres cambiarla, escribe solo la última parte (por ejemplo: lecturas-quimica), sin espacios ni acentos.'
          }
        </p>
        {err('slug') && <p class="field__error">{err('slug')}</p>}
      </div>

      <div class="field">
        <label for="summary">Resumen</label>
        <textarea
          id="summary"
          name="summary"
          rows="3"
          maxlength="320"
          required
          placeholder="Una o dos frases que inviten a leer la nota."
          aria-describedby="summary-help"
          aria-invalid={err('summary') ? 'true' : undefined}
          data-summary>{d.summary}</textarea
        >
        <p id="summary-help" class="field__help field__help--split">
          <span>Aparece en el listado de notas y en los resultados de Google.</span>
          <span class="counter" data-counter><span data-count>{d.summary.length}</span>/320</span>
        </p>
        {err('summary') && <p class="field__error">{err('summary')}</p>}
      </div>
    </section>

    <!-- 3. Texto -->
    <section class="step admin-card" aria-labelledby="step3">
      <h2 id="step3" class="step__title"><span class="step__n" aria-hidden="true">3</span> Texto de la nota</h2>
      <div class="field">
        <div class="editor">
          <div class="editor__bar" role="toolbar" aria-label="Formato del texto" data-toolbar hidden>
            <button type="button" data-md="bold" title="Negrita" aria-label="Negrita"><strong>B</strong></button>
            <button type="button" data-md="italic" title="Cursiva" aria-label="Cursiva"><em>I</em></button>
            <span class="editor__sep" aria-hidden="true"></span>
            <button type="button" data-md="h2" title="Subtítulo">Subtítulo</button>
            <button type="button" data-md="ul" title="Lista con viñetas">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1" /><circle cx="4.5" cy="12" r="1" /><circle cx="4.5" cy="18" r="1" /></svg>
              Lista
            </button>
            <button type="button" data-md="ol" title="Lista numerada">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6h10M10 12h10M10 18h10M4 5l1.5-1v5M3.5 14.5a1.5 1.5 0 1 1 2.6 1L3.5 19H6.5" /></svg>
              Numerada
            </button>
            <button type="button" data-md="quote" title="Cita">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v4c0 3-1.5 5-4 6M15 7h4v4c0 3-1.5 5-4 6" /></svg>
              Cita
            </button>
            <button type="button" data-md="link" title="Enlace dentro del texto">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
              Enlace
            </button>
          </div>
          <textarea
            id="content"
            name="content"
            rows="16"
            placeholder="Escribe aquí el texto de la nota.

Deja una línea en blanco entre párrafos. Usa los botones de arriba para dar formato."
            aria-label="Texto de la nota"
            aria-describedby="content-help"
            data-content>{d.content}</textarea
          >
        </div>
        <details class="howto" id="content-help">
          <summary>Guía rápida de formato</summary>
          <p>Los botones escriben estos símbolos por ti; también puedes escribirlos a mano:</p>
          <dl>
            <div><dt><code>**texto**</code></dt><dd><strong>negrita</strong></dd></div>
            <div><dt><code>*texto*</code></dt><dd><em>cursiva</em></dd></div>
            <div><dt><code>## Título</code></dt><dd>subtítulo</dd></div>
            <div><dt><code>- elemento</code></dt><dd>lista con viñetas</dd></div>
            <div><dt><code>1. elemento</code></dt><dd>lista numerada</dd></div>
            <div><dt><code>&gt; texto</code></dt><dd>cita</dd></div>
            <div><dt><code>[texto](https://…)</code></dt><dd>enlace</dd></div>
          </dl>
        </details>
        {err('content') && <p class="field__error">{err('content')}</p>}
      </div>
    </section>

    <!-- 4. Enlaces -->
    <section class="step admin-card" aria-labelledby="links-title">
      <h2 id="links-title" class="step__title">
        <span class="step__n" aria-hidden="true">4</span> Enlaces recomendados <span class="optional">opcional</span>
      </h2>
      <p class="field__help">
        Para recomendar un artículo o un libro: pega su dirección (DOI, editorial, tienda) y ponle un título. Aparecen al final de la nota.
      </p>
      {err('links') && <p class="field__error">{err('links')}</p>}
      <div class="links" data-links>
        {
          links.map((l) => (
            <fieldset class="link-row" data-link-row>
              <legend class="visually-hidden">Enlace</legend>
              <label class="link-row__url">
                Dirección del enlace
                <input name="link_url" type="url" value={l.url} placeholder="https://doi.org/…" data-link-url />
              </label>
              <label class="link-row__title">
                Título que se verá
                <input name="link_title" value={l.title} maxlength="200" placeholder="Nombre del artículo o libro" data-link-title />
              </label>
              <label class="link-row__kind">
                Tipo
                <select name="link_kind" data-link-kind>
                  {LINK_KINDS.map((k) => (
                    <option value={k} selected={l.kind === k}>
                      {tEs(`notes.kind.${k}`)}
                    </option>
                  ))}
                </select>
              </label>
              <label class="link-row__desc">
                <span>Comentario corto <span class="optional">opcional</span></span>
                <input name="link_description" value={l.description} maxlength="300" placeholder="Por qué vale la pena leerlo" data-link-desc />
              </label>
              <button type="button" class="link-btn link-btn--danger link-row__remove" data-remove-link hidden>
                Quitar enlace
              </button>
            </fieldset>
          ))
        }
      </div>
      <button type="button" class="admin-btn admin-btn--ghost" data-add-link hidden>+ Agregar enlace</button>
    </section>

    <!-- 5. PDF -->
    <section class="step admin-card" aria-labelledby="files-title">
      <h2 id="files-title" class="step__title">
        <span class="step__n" aria-hidden="true">5</span> Archivo PDF <span class="optional">opcional</span>
      </h2>
      {
        d.attachments.length > 0 && (
          <ul role="list" class="files">
            {d.attachments.map((a) => (
              <li>
                <span class="files__icon" aria-hidden="true">PDF</span>
                <span class="files__name">
                  <strong>{a.title}</strong>
                  <span>
                    {a.originalFilename} · {formatBytes(a.sizeBytes, 'es')}
                  </span>
                </span>
                <label class="check check--danger">
                  <input type="checkbox" name="remove_attachment" value={a.id} data-remove-file /> Quitar al guardar
                </label>
              </li>
            ))}
          </ul>
        )
      }
      <div class="field">
        <label for="new_file" class="upload">
          <span class="upload__title">{d.attachments.length > 0 ? 'Agregar otro PDF' : 'Elegir un PDF de tu equipo'}</span>
          <span class="upload__hint">Solo PDF, hasta 20 MB. Los lectores podrán abrirlo o descargarlo.</span>
        </label>
        <input
          id="new_file"
          name="new_file"
          type="file"
          accept="application/pdf,.pdf"
          aria-invalid={err('new_file') ? 'true' : undefined}
          data-file
        />
      </div>
      <div class="file-extra" data-file-extra>
        <div class="field">
          <label for="new_file_title">Nombre que verán los lectores</label>
          <input id="new_file_title" name="new_file_title" maxlength="200" placeholder="Si lo dejas vacío, se usa el nombre del archivo" data-file-title />
        </div>
        <fieldset class="field">
          <legend>¿Se puede compartir este PDF? <span class="req">obligatorio</span></legend>
          <div class="radios">
            {
              rightsOrder.map((r) => (
                <label class="check">
                  <input type="radio" name="new_file_rights" value={r} /> {rightsLabels[r]}
                </label>
              ))
            }
          </div>
          <p class="field__help">Si no es ninguno de estos casos, no lo subas: agrega mejor un enlace a la editorial o al DOI en el paso 4.</p>
        </fieldset>
      </div>
      {
        err('new_file') && (
          <p class="field__error">
            {err('new_file')} Vuelve a elegir el archivo: el navegador lo quita al mostrar un error.
          </p>
        )
      }
    </section>

    <!-- Más opciones -->
    <details class="step admin-card more" open={advancedErrors}>
      <summary>
        <span class="more__title">Más opciones</span>
        <span class="more__hint">Fecha, etiquetas, líneas de investigación, destacar</span>
      </summary>
      <div class="more__body">
        <div class="grid-2">
          <div class="field">
            <label for="publishedAt">Fecha de publicación</label>
            <input id="publishedAt" name="publishedAt" type="date" value={d.publishedAt} aria-describedby="pub-help" aria-invalid={err('publishedAt') ? 'true' : undefined} data-published />
            <p id="pub-help" class="field__help">Por defecto, hoy. Puedes poner una fecha anterior.</p>
            {err('publishedAt') && <p class="field__error">{err('publishedAt')}</p>}
          </div>
          <div class="field">
            <label for="revisedAt">Fecha de actualización <span class="optional">opcional</span></label>
            <input id="revisedAt" name="revisedAt" type="date" value={d.revisedAt} aria-describedby="rev-help" aria-invalid={err('revisedAt') ? 'true' : undefined} data-revised />
            <p id="rev-help" class="field__help">Solo si corriges la nota después de publicarla: se mostrará «Actualizada: …».</p>
            {err('revisedAt') && <p class="field__error">{err('revisedAt')}</p>}
          </div>
        </div>

        <div class="field">
          <label for="tags">Etiquetas <span class="optional">opcional</span></label>
          <input id="tags" name="tags" value={d.tags.join(', ')} placeholder="DFT, clústeres, docencia" aria-describedby="tags-help" aria-invalid={err('tags') ? 'true' : undefined} data-tags />
          <p id="tags-help" class="field__help">Palabras clave separadas por comas (máximo 10). Ayudan a encontrar notas del mismo tema.</p>
          {err('tags') && <p class="field__error">{err('tags')}</p>}
        </div>

        <fieldset class="field">
          <legend>Líneas de investigación relacionadas <span class="optional">opcional</span></legend>
          <div class="chips">
            {
              research.map((r) => (
                <label class="chip">
                  <input type="checkbox" name="researchAreas" value={r.id} checked={d.researchAreas.includes(r.id)} data-research />
                  <span>{r.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {
          singleAuthor ? (
            <input type="hidden" name="authorId" value={singleAuthor.id} data-author />
          ) : (
            <div class="field">
              <label for="authorId">Autor</label>
              <select id="authorId" name="authorId" aria-invalid={err('authorId') ? 'true' : undefined} data-author>
                {authors.map((a) => (
                  <option value={a.id} selected={d.authorId === a.id}>
                    {a.label}
                  </option>
                ))}
              </select>
              {err('authorId') && <p class="field__error">{err('authorId')}</p>}
            </div>
          )
        }

        <label class="toggle">
          <input type="checkbox" name="featured" checked={d.featured} />
          <span class="toggle__text">
            <strong>Destacar esta nota</strong>
            <span>Se muestra primero y más grande en la página de Notas. Solo puede haber una destacada: al marcar esta, se quita la marca a la anterior.</span>
          </span>
        </label>
      </div>
    </details>

    <!-- Guardar -->
    <div class="savebar">
      <p class="savebar__hint">
        {
          isPublished
            ? 'Los cambios se verán en el sitio al guardar.'
            : 'Los borradores no se ven en el sitio.'
        }
      </p>
      <div class="savebar__actions">
        <button type="submit" name="action" value="save" class:list={['admin-btn', { 'admin-btn--primary': isPublished }]}>
          {isPublished ? 'Guardar cambios' : 'Guardar borrador'}
        </button>
        {
          !isPublished && (
            <button type="submit" name="action" value="publish" class="admin-btn admin-btn--primary">
              Publicar
            </button>
          )
        }
      </div>
    </div>
  </form>

  <aside class="preview" aria-label="Vista previa en vivo" data-preview-pane>
    <div class="preview__bar">
      <span class="preview__label"><span class="dot" aria-hidden="true"></span> Vista previa · así se verá en el sitio</span>
      <span class="preview__url" data-pv-url>{host}{prefixes[d.lang]}{d.slug || '…'}/</span>
    </div>
    <div class="preview__page" tabindex="0" data-pv-page>
      <noscript><p class="preview__empty">La vista previa en vivo necesita JavaScript activado.</p></noscript>
    </div>
  </aside>
</div>

<dialog class="link-dialog" data-link-dialog aria-labelledby="link-dialog-title">
  <form method="dialog" data-link-dialog-form>
    <h2 id="link-dialog-title">Agregar un enlace en el texto</h2>
    <label>
      Texto que se verá
      <input name="text" data-dialog-text placeholder="por ejemplo: este artículo" />
    </label>
    <label>
      Dirección
      <input name="url" type="url" data-dialog-url placeholder="https://…" />
    </label>
    <p class="field__error" data-dialog-error hidden>Pega una dirección completa que empiece con https://</p>
    <div class="link-dialog__actions">
      <button type="button" class="admin-btn" data-dialog-cancel>Cancelar</button>
      <button type="submit" class="admin-btn admin-btn--primary" value="ok">Insertar enlace</button>
    </div>
  </form>
</dialog>

<template data-link-template>
  <fieldset class="link-row" data-link-row>
    <legend class="visually-hidden">Enlace</legend>
    <label class="link-row__url">Dirección del enlace <input name="link_url" type="url" placeholder="https://doi.org/…" data-link-url /></label>
    <label class="link-row__title">Título que se verá <input name="link_title" maxlength="200" placeholder="Nombre del artículo o libro" data-link-title /></label>
    <label class="link-row__kind">
      Tipo
      <select name="link_kind" data-link-kind>
        {LINK_KINDS.map((k) => <option value={k}>{tEs(`notes.kind.${k}`)}</option>)}
      </select>
    </label>
    <label class="link-row__desc">
      <span>Comentario corto <span class="optional">opcional</span></span>
      <input name="link_description" maxlength="300" placeholder="Por qué vale la pena leerlo" data-link-desc />
    </label>
    <button type="button" class="link-btn link-btn--danger link-row__remove" data-remove-link>Quitar enlace</button>
  </fieldset>
</template>

<script type="application/json" data-preview-config set:html={JSON.stringify(previewConfig).replace(/</g, '\\u003c')} />

<script>
