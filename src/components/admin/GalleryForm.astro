---
/**
 * Formulario de una foto de la Galería (ADR-015). Pasos: foto · textos · fecha y créditos · permiso.
 * Con JavaScript, la foto se reduce en el navegador antes de subirla (gallery-editor.ts) y se ve cómo
 * queda recortada en la cuadrícula. Sin JavaScript se sube el original (hasta 10 MB).
 */
import {
  galleryFocus,
  galleryFocusIds,
  galleryLicenseIds,
  galleryLicenses,
  galleryRights,
  galleryRightsIds,
} from '../../config/gallery';
import { LIMITS, type AdminPhoto, type FieldErrors, type GalleryDraft } from '../../utils/admin-gallery';
import { formatBytes } from '../../utils/notes';

interface Props {
  draft: GalleryDraft;
  errors: FieldErrors;
  /** Foto ya guardada (al editar). */
  photo?: AdminPhoto;
}
const { draft: d, errors, photo } = Astro.props;
const isNew = !photo;
const err = (k: keyof FieldErrors) => errors[k];
const hasErrors = Object.keys(errors).length > 0;
const trName = { es: 'inglés', en: 'español' } as const;
const langName = { es: 'español', en: 'inglés' } as const;
const trOpen = Boolean(d.captionTr || d.altTr || d.placeTr || err('captionTr') || err('altTr') || err('placeTr'));
const maxYear = new Date().getUTCFullYear() + 1;

const labels: Record<string, string> = {
  photo: 'Foto',
  caption: 'Pie de foto',
  alt: 'Descripción',
  place: 'Lugar',
  captionTr: 'Traducción del pie de foto',
  altTr: 'Traducción de la descripción',
  placeTr: 'Traducción del lugar',
  year: 'Año',
  takenOn: 'Fecha',
  credit: 'Autor de la foto',
  sourceUrl: 'Dónde está publicada',
  rights: 'Permiso para publicarla',
};
const targets: Record<string, string> = { rights: `rights-${galleryRightsIds[0]}` };
---

<form method="post" enctype="multipart/form-data" class="gallery-form" data-gallery-form>
  {
    hasErrors && (
      <div class="admin-flash admin-flash--error" role="alert" tabindex="-1" data-error-summary>
        <strong>Revisa lo siguiente antes de guardar:</strong>
        <ul>
          {Object.entries(errors).map(([k, msg]) => (
            <li>
              <a href={`#${targets[k] ?? k}`}>{labels[k] ?? k}</a>: {msg}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- 1. Foto -->
  <section class="step admin-card" aria-labelledby="g-step1">
    <h2 id="g-step1" class="step__title"><span class="step__n" aria-hidden="true">1</span> {isNew ? 'Elige la foto' : 'Foto'}</h2>

    <div class="photo">
      <div class="photo__frame" data-frame data-empty={isNew ? '' : undefined}>
        {
          photo ? (
            <img src={photo.thumbUrl} alt="" width={photo.width} height={photo.height} data-preview-img style={`object-position:${galleryFocus[d.focus].position}`} />
          ) : (
            <img alt="" data-preview-img hidden style={`object-position:${galleryFocus[d.focus].position}`} />
          )
        }
        <span class="photo__placeholder" aria-hidden="true">Aquí verás cómo queda en la galería</span>
      </div>
      <div class="photo__side">
        <div class="field">
          <label for="photo" class="upload">
            <span class="upload__title">{isNew ? 'Foto desde tu equipo o tu celular' : 'Cambiar por otra foto'} {isNew && <span class="req">obligatorio</span>}</span>
            <span class="upload__hint">JPG, PNG o WebP. No importa si es muy grande: se reduce sola antes de subir.</span>
          </label>
          <input
            id="photo"
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
            required={isNew}
            aria-invalid={err('photo') ? 'true' : undefined}
            aria-describedby="photo-status"
            data-photo
          />
          <input type="file" name="thumb" hidden tabindex="-1" aria-hidden="true" data-thumb />
          <input type="hidden" name="original_name" data-original-name />
          <p id="photo-status" class="field__help" data-photo-status aria-live="polite">
            {photo && `Actual: ${photo.width} × ${photo.height} px · ${formatBytes(photo.sizeBytes, 'es')}`}
          </p>
          {err('photo') && <p class="field__error">{err('photo')} Vuelve a elegir el archivo.</p>}
        </div>

        <fieldset class="field">
          <legend>¿Qué parte se ve en la cuadrícula?</legend>
          <div class="pills">
            {
              galleryFocusIds.map((f) => (
                <label class="pill">
                  <input type="radio" name="focus" value={f} checked={d.focus === f} data-focus={galleryFocus[f].position} />
                  <span>{galleryFocus[f].label}</span>
                </label>
              ))
            }
          </div>
          <p class="field__help">La cuadrícula muestra la foto un poco recortada; al abrirla se ve completa.</p>
        </fieldset>
      </div>
    </div>
  </section>

  <!-- 2. Textos -->
  <section class="step admin-card" aria-labelledby="g-step2">
    <h2 id="g-step2" class="step__title"><span class="step__n" aria-hidden="true">2</span> Qué muestra la foto</h2>

    <fieldset class="field">
      <legend>¿En qué idioma escribes?</legend>
      <div class="pills">
        <label class="pill">
          <input type="radio" name="lang" value="es" checked={d.lang === 'es'} data-lang />
          <span>Español</span>
        </label>
        <label class="pill">
          <input type="radio" name="lang" value="en" checked={d.lang === 'en'} data-lang />
          <span>Inglés (English)</span>
        </label>
      </div>
      <p class="field__help">Si no agregas la traducción, el sitio en el otro idioma muestra estos mismos textos.</p>
    </fieldset>

    <div class="field">
      <label for="caption">Pie de foto <span class="req">obligatorio</span></label>
      <input id="caption" name="caption" value={d.caption} maxlength={LIMITS.caption} required placeholder="Por ejemplo: Con estudiantes en el taller de microscopía" aria-describedby="caption-help" aria-invalid={err('caption') ? 'true' : undefined} data-count />
      <p id="caption-help" class="field__help field__help--split">
        <span>Frase corta que aparece debajo de la foto.</span>
        <span class="counter" data-counter-for="caption">{d.caption.length}/{LIMITS.caption}</span>
      </p>
      {err('caption') && <p class="field__error">{err('caption')}</p>}
    </div>

    <div class="field">
      <label for="alt">Descripción de lo que se ve <span class="req">obligatorio</span></label>
      <textarea id="alt" name="alt" rows="3" maxlength={LIMITS.alt} required placeholder="Por ejemplo: El Dr. Cabellos explica una estructura molecular a cuatro estudiantes frente a una pantalla." aria-describedby="alt-help" aria-invalid={err('alt') ? 'true' : undefined} data-count>{d.alt}</textarea>
      <p id="alt-help" class="field__help field__help--split">
        <span>No se ve en la página: la leen los lectores de pantalla de personas ciegas y los buscadores. Di quién aparece y qué hacen.</span>
        <span class="counter" data-counter-for="alt">{d.alt.length}/{LIMITS.alt}</span>
      </p>
      {err('alt') && <p class="field__error">{err('alt')}</p>}
    </div>

    <div class="field">
      <label for="place">Lugar <span class="optional">opcional</span></label>
      <input id="place" name="place" value={d.place} maxlength={LIMITS.place} placeholder="Por ejemplo: Tapachula, Chiapas" aria-invalid={err('place') ? 'true' : undefined} />
      {err('place') && <p class="field__error">{err('place')}</p>}
    </div>

    <details class="tr" open={trOpen}>
      <summary>
        <span class="tr__title">Traducción al <span data-tr-name>{trName[d.lang]}</span></span>
        <span class="optional">opcional</span>
      </summary>
      <div class="tr__body">
        <div class="field">
          <label for="captionTr">Pie de foto en <span data-tr-name>{trName[d.lang]}</span></label>
          <input id="captionTr" name="captionTr" value={d.captionTr} maxlength={LIMITS.caption} aria-invalid={err('captionTr') ? 'true' : undefined} />
          {err('captionTr') && <p class="field__error">{err('captionTr')}</p>}
        </div>
        <div class="field">
          <label for="altTr">Descripción en <span data-tr-name>{trName[d.lang]}</span></label>
          <textarea id="altTr" name="altTr" rows="3" maxlength={LIMITS.alt} aria-invalid={err('altTr') ? 'true' : undefined}>{d.altTr}</textarea>
          {err('altTr') && <p class="field__error">{err('altTr')}</p>}
        </div>
        <div class="field">
          <label for="placeTr">Lugar en <span data-tr-name>{trName[d.lang]}</span></label>
          <input id="placeTr" name="placeTr" value={d.placeTr} maxlength={LIMITS.place} aria-invalid={err('placeTr') ? 'true' : undefined} />
          {err('placeTr') && <p class="field__error">{err('placeTr')}</p>}
        </div>
        <p class="field__help">Se muestra en la versión en <span data-tr-name>{trName[d.lang]}</span> del sitio. Los textos originales siguen en <span data-lang-name>{langName[d.lang]}</span>.</p>
      </div>
    </details>
  </section>

  <!-- 3. Fecha y créditos -->
  <section class="step admin-card" aria-labelledby="g-step3">
    <h2 id="g-step3" class="step__title"><span class="step__n" aria-hidden="true">3</span> Fecha y créditos</h2>

    <div class="grid-2">
      <div class="field">
        <label for="year">Año <span class="req">obligatorio</span></label>
        <input id="year" name="year" type="number" inputmode="numeric" min="1900" max={maxYear} step="1" value={d.year} required aria-describedby="year-help" aria-invalid={err('year') ? 'true' : undefined} data-year />
        <p id="year-help" class="field__help">La galería va de las fotos más recientes a las más antiguas.</p>
        {err('year') && <p class="field__error">{err('year')}</p>}
      </div>
      <div class="field">
        <label for="takenOn">Fecha exacta <span class="optional">opcional</span></label>
        <input id="takenOn" name="takenOn" type="date" value={d.takenOn} aria-describedby="date-help" aria-invalid={err('takenOn') ? 'true' : undefined} data-date />
        <p id="date-help" class="field__help">Sirve para ordenar las fotos del mismo año. Si la pones, el año se toma de aquí.</p>
        {err('takenOn') && <p class="field__error">{err('takenOn')}</p>}
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label for="credit">¿Quién tomó la foto? <span class="req">obligatorio</span></label>
        <input id="credit" name="credit" value={d.credit} maxlength={LIMITS.credit} required aria-invalid={err('credit') ? 'true' : undefined} />
        {err('credit') && <p class="field__error">{err('credit')}</p>}
      </div>
      <div class="field">
        <label for="license">Licencia</label>
        <select id="license" name="license" aria-describedby="license-help">
          {galleryLicenseIds.map((l) => <option value={l} selected={d.license === l}>{galleryLicenses[l].label}</option>)}
        </select>
        <p id="license-help" class="field__help">Solo si la foto ya se publicó con esa licencia (como las de Figshare).</p>
      </div>
    </div>

    <div class="field">
      <label for="sourceUrl">Dónde está publicada la original <span class="optional">opcional</span></label>
      <input id="sourceUrl" name="sourceUrl" type="url" inputmode="url" value={d.sourceUrl} maxlength={LIMITS.url} placeholder="https://…" aria-describedby="source-help" aria-invalid={err('sourceUrl') ? 'true' : undefined} />
      <p id="source-help" class="field__help">Por ejemplo, su página en Figshare. Si la pones, aparece el enlace «Fuente» al pie.</p>
      {err('sourceUrl') && <p class="field__error">{err('sourceUrl')}</p>}
    </div>
  </section>

  <!-- 4. Permiso -->
  <section class="step admin-card" aria-labelledby="g-step4">
    <h2 id="g-step4" class="step__title"><span class="step__n" aria-hidden="true">4</span> Permiso para publicarla</h2>
    <fieldset class="field">
      <legend>¿Por qué se puede publicar esta foto? <span class="req">obligatorio</span></legend>
      <div class="radios">
        {
          galleryRightsIds.map((r, i) => (
            <label class="check">
              <input type="radio" id={`rights-${r}`} name="rights" value={r} checked={d.rights === r} required={i === 0} aria-invalid={err('rights') ? 'true' : undefined} /> {galleryRights[r]}
            </label>
          ))
        }
      </div>
      <p class="field__help">Si en la foto aparecen personas, que estén de acuerdo en que se publique. Si no es ninguno de estos casos, mejor no la subas.</p>
      {err('rights') && <p class="field__error">{err('rights')}</p>}
    </fieldset>
  </section>

  <div class="savebar admin-card">
    <p class="savebar__state">
      {
        isNew
          ? 'Al publicarla, aparece de inmediato en la galería del sitio.'
          : d.status === 'published'
            ? 'Esta foto está publicada: los cambios se ven en el sitio al guardar.'
            : 'Esta foto no está publicada: solo se ve aquí en el panel.'
      }
    </p>
    <div class="savebar__actions">
      {
        isNew ? (
          <>
            <button type="submit" class="admin-btn" name="action" value="save">Guardar sin publicar</button>
            <button type="submit" class="admin-btn admin-btn--primary" name="action" value="publish">Publicar foto</button>
          </>
        ) : (
          <button type="submit" class="admin-btn admin-btn--primary" name="action" value="save">Guardar cambios</button>
        )
      }
    </div>
  </div>
</form>

<script>
  import { initGalleryEditor } from './gallery-editor';
  const form = document.querySelector<HTMLFormElement>('[data-gallery-form]');
  if (form) initGalleryEditor(form);
  document.querySelector<HTMLElement>('[data-error-summary]')?.focus();
</script>

<style>
  .gallery-form {
    display: grid;
    gap: var(--space-6);
    max-width: 56rem;
  }
  .step {
    display: grid;
    gap: var(--space-5, 1.25rem);
    min-width: 0;
  }
  .step__title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-lg);
  }
  .step__n {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .optional,
  .req {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: lowercase;
  }
  .req {
    color: var(--color-error);
  }
  .field {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .field > label,
  .field legend {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .field legend {
    margin-bottom: var(--space-2);
  }
  .field__help {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .field__help--split {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .counter {
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .counter.is-near {
    color: var(--color-warning);
    font-weight: 600;
  }
  .field__error {
    font-size: var(--text-sm);
    color: var(--color-error);
    font-weight: 500;
  }
  .field__help.is-error {
    color: var(--color-error);
    font-weight: 500;
  }
  .gallery-form [aria-invalid='true'] {
    border-color: var(--color-error);
    box-shadow: 0 0 0 1px var(--color-error);
  }
  .admin-flash ul {
    margin-top: var(--space-2);
    padding-left: 1.25rem;
    list-style: disc;
  }
  .admin-flash a {
    color: inherit;
  }
  .grid-2 {
    display: grid;
    gap: var(--space-5, 1.25rem);
  }
  @media (min-width: 640px) {
    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Foto y vista del recorte */
  .photo {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .photo {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
    }
  }
  .photo__side {
    display: grid;
    gap: var(--space-5, 1.25rem);
    min-width: 0;
  }
  .photo__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    box-shadow: var(--shadow-sm);
  }
  .photo__frame img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__frame img[hidden] {
    display: none;
  }
  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
  .photo__frame[data-busy]::after {
    content: 'Preparando…';
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.75);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .upload {
    display: grid;
    gap: var(--space-1);
    font-weight: 600;
  }
  .upload__hint {
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  input[type='file'] {
    width: 100%;
    padding: var(--space-4);
    border: 2px dashed #c3cdc8;
    border-radius: var(--radius-md);
    background: #fbfcfc;
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  input[type='file']:hover {
    border-color: var(--color-primary);
  }
  input[type='file']::file-selector-button {
    margin-right: var(--space-3);
    min-height: 36px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-primary);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  /* Píldoras (idioma y recorte) */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pill {
    position: relative;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pill span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid #c3cdc8;
    border-radius: var(--radius-pill);
    background: #fff;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .pill input:checked + span {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }
  .pill input:focus-visible + span {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .radios {
    display: grid;
    gap: var(--space-3);
  }
  .check {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    margin-top: 0.1em;
    flex: none;
    accent-color: var(--color-primary);
  }

  /* Traducción */
  .tr {
    border: var(--border);
    border-radius: var(--radius-sm);
    background: #fbfcfc;
  }
  .tr summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .tr__body {
    display: grid;
    gap: var(--space-4);
    padding: 0 var(--space-4) var(--space-4);
  }

  /* Barra de guardado */
  .savebar {
    position: sticky;
    bottom: var(--space-3);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-4) var(--space-6);
    box-shadow: var(--shadow-md);
  }
  .savebar__state {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .savebar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (max-width: 559px) {
    .savebar {
      bottom: 0;
      padding: var(--space-3);
    }
    .savebar__actions,
    .savebar__actions .admin-btn {
      flex: 1 1 auto;
      min-height: 48px;
    }
  }
</style>
