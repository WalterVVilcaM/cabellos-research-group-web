---
/** Foto del integrante o, si no existe, avatar tipográfico con iniciales (RF-16). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { initials } from '../../utils/content';

interface Props {
  name: string;
  photo?: ImageMetadata;
  size?: 'sm' | 'md' | 'lg';
  loading?: 'eager' | 'lazy';
}
const { name, photo, size = 'md', loading = 'lazy' } = Astro.props;
const px = { sm: 72, md: 120, lg: 240 }[size];
---

<div class:list={['avatar', `avatar--${size}`]}>
  {
    photo ? (
      <Image
        src={photo}
        alt={name}
        width={px}
        height={Math.round(px * 1.25)}
        widths={[px, px * 2]}
        loading={loading}
        class="avatar__img"
      />
    ) : (
      <span class="avatar__initials" aria-hidden="true">
        {initials(name)}
      </span>
    )
  }
</div>

<style>
  .avatar {
    position: relative;
    flex: none;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }
  .avatar--sm {
    width: 72px;
  }
  .avatar--md {
    width: 120px;
  }
  .avatar--lg {
    width: min(100%, 240px);
  }
  .avatar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }
  .avatar--sm .avatar__initials {
    font-size: 1.5rem;
  }
  .avatar--md .avatar__initials {
    font-size: 2.25rem;
  }
  .avatar--lg .avatar__initials {
    font-size: 4rem;
  }
</style>
