---
/**
 * Figura publicada por el grupo usada como portada de una línea, con crédito y licencia.
 * PROVISIONAL: las figuras vienen de artículos en acceso abierto (CC BY 4.0) del PI;
 * se reemplazan editando `cover` en research.yaml.
 */
import { Image } from 'astro:assets';
import RichText from '../ui/RichText.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { getCoverSource, shortAuthors, type Research } from '../../utils/content';

interface Props {
  item: Research;
  lang: Lang;
  /** `sizes` del srcset. */
  sizes?: string;
  loading?: 'eager' | 'lazy';
  /** Muestra el pie (título + crédito). Si es false, solo el crédito compacto. */
  caption?: boolean;
  /** Relación de aspecto del marco (la imagen se ajusta con contain). */
  ratio?: string;
  class?: string;
}
const {
  item,
  lang,
  sizes = '(min-width: 1100px) 560px, 100vw',
  loading = 'lazy',
  caption = true,
  ratio = '4 / 3',
  class: className,
} = Astro.props;
const t = useTranslations(lang);
const cover = item.data.cover;
const src = cover ? await getCoverSource(item) : undefined;
const credit = src
  ? t('figure.credit', {
      fig: cover!.figure,
      authors: shortAuthors(src.data.authors),
      journal: src.data.journal,
      year: src.data.year,
    })
  : '';
const doiHref = src?.data.doi ? `https://doi.org/${src.data.doi}` : undefined;
---

{
  cover && (
    <figure class:list={['rfig', className]} style={`--ratio: ${ratio}`}>
      <div class="rfig__frame">
        <Image
          src={cover.image}
          alt={cover.alt[lang]}
          widths={[340, 680]}
          sizes={sizes}
          loading={loading}
          fetchpriority={loading === 'eager' ? 'high' : undefined}
          class="rfig__img"
        />
      </div>
      <figcaption class="rfig__caption">
        {caption && (
          <span class="rfig__text">
            <RichText text={cover.caption[lang]} />{' '}
          </span>
        )}
        <span class="rfig__credit">
          {doiHref ? <a href={doiHref}>{credit}</a> : credit}{' '}
          <a href={cover.licenseUrl} rel="license">
            {cover.license}
          </a>
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .rfig {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    min-width: 0;
  }
  .rfig__frame {
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    aspect-ratio: var(--ratio);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: #fff;
    border: 1px solid rgb(16 24 20 / 0.06);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .rfig__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .rfig__caption {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .rfig__text {
    color: var(--color-text);
  }
  .rfig__caption :global(sub),
  .rfig__caption :global(sup) {
    font-size: 0.75em;
    line-height: 0;
  }
  .rfig__credit a {
    color: inherit;
  }
  .rfig__credit a:hover {
    color: var(--color-primary);
  }
</style>
