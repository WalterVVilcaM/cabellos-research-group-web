---
export const prerender = false; // Notes se lee de D1 en cada visita (ADR-011)
import View from '../../../../views/NotesView.astro';
import { categoryBySlug, loadNotesListing, notFound } from '../../../../utils/notes';

const category = categoryBySlug(Astro.params.category ?? '', 'es');
const data = category ? await loadNotesListing(1, category) : null;
if (!data || !category) return notFound(Astro.url);
---

<View lang="es" data={data} category={category} />
