---
/** Panel: editar una nota y cambiar su estado (VIEW-ADMIN-003). */
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import NoteForm from '../../../../components/admin/NoteForm.astro';
import {
  deleteNotePermanently,
  getAdminNote,
  setStatus,
  type FieldErrors,
  type NoteStatus,
} from '../../../../utils/admin-notes';
import { formOptions, handleSave } from '../../../../utils/admin-form';
import { notePath, withBase } from '../../../../i18n/utils';

const id = Number(Astro.params.id);
const base = Number.isInteger(id) ? await getAdminNote(id) : undefined;
if (!base) return new Response('Nota no encontrada', { status: 404 });

let draft = base;
let errors: FieldErrors = {};
let opts = await formOptions();
let flash: string | null = null;
const here = withBase(`/admin/notas/${id}/`);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const transitions: Record<string, { to: NoteStatus; from: NoteStatus[]; flag: string }> = {
    unpublish: { to: 'draft', from: ['published'], flag: 'despublicada' },
    archive: { to: 'archived', from: ['draft', 'published'], flag: 'archivada' },
    restore: { to: 'draft', from: ['archived'], flag: 'restaurada' },
    'publish-now': { to: 'published', from: ['draft', 'archived'], flag: 'publicada' },
  };
  if (action in transitions) {
    const tr = transitions[action]!;
    if (tr.from.includes(base.status)) await setStatus(id, tr.to);
    return Astro.redirect(`${here}?ok=${tr.flag}`, 303);
  }
  if (action === 'delete') {
    if (base.status === 'archived' && String(form.get('confirm')).trim().toUpperCase() === 'ELIMINAR') {
      await deleteNotePermanently(id);
      return Astro.redirect(withBase('/admin/notas/?ok=eliminada'), 303);
    }
    flash = 'Para eliminar escribe ELIMINAR (solo notas archivadas).';
  } else {
    const result = await handleSave(form, base, Astro.locals.adminEmail ?? '');
    if (result.ok) {
      const flag = result.uploadError ? 'archivo' : result.published ? 'publicada' : 'guardada';
      return Astro.redirect(`${here}?ok=${flag}`, 303);
    }
    ({ draft, errors, opts } = result);
    Astro.response.status = 422;
  }
}

const messages: Record<string, string> = {
  creada: 'Nota creada como borrador.',
  guardada: 'Cambios guardados.',
  publicada: 'Nota publicada: ya se ve en el sitio.',
  despublicada: 'La nota volvió a borrador y ya no se ve en el sitio.',
  archivada: 'Nota archivada: ya no aparece en el sitio.',
  restaurada: 'Nota restaurada como borrador.',
  archivo: 'La nota se guardó, pero el PDF no se pudo subir. Inténtalo de nuevo.',
};
const ok = Astro.url.searchParams.get('ok');
const statusLabel = { draft: 'Borrador', published: 'Publicada', archived: 'Archivada' } as const;
---

<AdminLayout title={base.title} current="notes" wide>
  <div class="head">
    <div>
      <p class="crumb"><a href={withBase('/admin/notas/')}>Notas</a> ›</p>
      <h1>{base.title}</h1>
      <p class="meta">
        <span class={`status status--${base.status}`}>{statusLabel[base.status]}</span>
        {base.isTest && <span class="status status--test">Prueba</span>}
        <span class="muted">Actualizada: {new Date(base.updatedAt ?? '').toLocaleString('es-MX', { timeZone: 'America/Mexico_City' })}</span>
      </p>
    </div>
    <div class="head__links">
      {
        base.status === 'published' ? (
          <a class="admin-btn" href={notePath(base.slug, base.lang)} target="_blank" rel="noopener">Ver en el sitio</a>
        ) : (
          <a class="admin-btn" href={`${here}vista-previa/`} target="_blank" rel="noopener">Vista previa</a>
        )
      }
    </div>
  </div>

  {ok && messages[ok] && <p class="admin-flash" role="status">{messages[ok]}</p>}
  {flash && <p class="admin-flash admin-flash--error" role="alert">{flash}</p>}

  <NoteForm draft={draft} errors={errors} research={opts.research} authors={opts.authors} />

  <section class="admin-card state" aria-labelledby="state-title">
    <h2 id="state-title">Publicación y archivo</h2>
    <ul role="list" class="state__list">
      {
        base.status === 'published' && (
          <li>
            <form method="post">
              <button class="admin-btn" name="action" value="unpublish">Despublicar</button>
            </form>
            <p>La nota deja de verse en el sitio y vuelve a borrador. Puedes publicarla otra vez cuando quieras.</p>
          </li>
        )
      }
      {
        base.status !== 'archived' && (
          <li>
            <form method="post">
              <button class="admin-btn" name="action" value="archive">Archivar</button>
            </form>
            <p>La guarda aparte: no se ve en el sitio ni estorba en el listado. Se puede restaurar.</p>
          </li>
        )
      }
      {
        base.status === 'archived' && (
          <li>
            <form method="post">
              <button class="admin-btn" name="action" value="restore">Restaurar</button>
            </form>
            <p>La recupera como borrador para editarla o publicarla de nuevo.</p>
          </li>
        )
      }
    </ul>
    {
      base.status === 'archived' ? (
        <form method="post" class="danger">
          <label for="confirm">
            <strong>Eliminar para siempre.</strong> Se borran la nota y sus PDF; no se puede deshacer. Escribe <strong>ELIMINAR</strong> para confirmar:
          </label>
          <div class="danger__row">
            <input id="confirm" name="confirm" autocomplete="off" />
            <button class="admin-btn admin-btn--danger" name="action" value="delete">Eliminar definitivamente</button>
          </div>
        </form>
      ) : (
        <p class="muted small">Para eliminar una nota para siempre, primero archívala.</p>
      )
    }
  </section>
</AdminLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .head h1 {
    overflow-wrap: anywhere;
  }
  .crumb {
    font-size: var(--text-sm);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
  .state {
    display: grid;
    gap: var(--space-4);
  }
  .state h2 {
    font-size: var(--text-lg);
  }
  .state {
    max-width: 50rem;
  }
  .state__list {
    display: grid;
    gap: var(--space-3);
  }
  .state__list li {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .state__list .admin-btn {
    width: 100%;
  }
  @media (max-width: 559px) {
    .state__list li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
  .danger {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border);
    font-size: var(--text-sm);
  }
  .danger__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .danger input {
    flex: 1 1 10rem;
    width: auto;
    max-width: 16rem;
  }
  .small {
    font-size: var(--text-sm);
  }
</style>
