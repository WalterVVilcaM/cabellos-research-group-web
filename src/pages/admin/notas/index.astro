---
/** Panel: listado de notas con filtro por estado (VIEW-ADMIN-002). */
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAdminNotes, STATUSES, type NoteStatus } from '../../../utils/admin-notes';
import { noteCategories } from '../../../config/notes';
import { withBase, notePath } from '../../../i18n/utils';

const estado = Astro.url.searchParams.get('estado');
const status = STATUSES.includes(estado as NoteStatus) ? (estado as NoteStatus) : undefined;
const notes = await listAdminNotes(status);
const statusLabel = { draft: 'Borrador', published: 'Publicada', archived: 'Archivada' } as const;
const filters = [
  { label: 'Todas', value: undefined },
  { label: 'Publicadas', value: 'published' },
  { label: 'Borradores', value: 'draft' },
  { label: 'Archivadas', value: 'archived' },
] as const;
const fmtDay = (day: string) =>
  new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${day}T00:00:00Z`));
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeZone: 'America/Mexico_City' }).format(new Date(iso));
---

<AdminLayout title="Notas" current="notes">
  <div class="head">
    <h1>Notas</h1>
    <a href={withBase('/admin/notas/nueva/')} class="admin-btn admin-btn--primary">+ Nueva nota</a>
  </div>

  <nav aria-label="Filtrar por estado">
    <ul role="list" class="filters">
      {
        filters.map((f) => (
          <li>
            <a
              href={withBase(`/admin/notas/${f.value ? `?estado=${f.value}` : ''}`)}
              aria-current={status === f.value ? 'page' : undefined}
            >
              {f.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="admin-card table-wrap">
    {
      notes.length === 0 ? (
        <p>No hay notas en este estado.</p>
      ) : (
        <table>
          <caption class="visually-hidden">Notas{status ? ` (${statusLabel[status]})` : ''}</caption>
          <thead>
            <tr>
              <th scope="col">Título</th>
              <th scope="col">Estado</th>
              <th scope="col">Categoría</th>
              <th scope="col">Idioma</th>
              <th scope="col">Publicación</th>
              <th scope="col">Actualizada</th>
              <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            {notes.map((n) => (
              <tr>
                <th scope="row">
                  <a href={withBase(`/admin/notas/${n.id}/`)}>{n.title}</a>
                </th>
                <td class="badges">
                  <span class={`status status--${n.status}`}>{statusLabel[n.status]}</span>
                  {n.isTest && <span class="status status--test">Prueba</span>}
                  {n.featured && <span class="status status--test">Destacada</span>}
                  {n.files > 0 && <span class="status status--file">{n.files} PDF</span>}
                </td>
                <td data-label="Categoría">{noteCategories[n.category].name.es}</td>
                <td data-label="Idioma">
                  <abbr title={n.lang === 'es' ? 'Español' : 'Inglés'}>{n.lang.toUpperCase()}</abbr>
                </td>
                <td class="nowrap" data-label="Publicación">{fmtDay(n.publishedAt)}</td>
                <td class="nowrap" data-label="Actualizada">{fmt(n.updatedAt)}</td>
                <td class="actions">
                  <a href={withBase(`/admin/notas/${n.id}/`)} class="act act--main">Editar<span class="visually-hidden">: {n.title}</span></a>
                  {n.status === 'published' ? (
                    <a href={notePath(n.slug, n.lang)} target="_blank" rel="noopener" class="act">Ver en el sitio<span class="visually-hidden">: {n.title} (nueva pestaña)</span></a>
                  ) : (
                    <a href={withBase(`/admin/notas/${n.id}/vista-previa/`)} target="_blank" rel="noopener" class="act">Vista previa<span class="visually-hidden">: {n.title} (nueva pestaña)</span></a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</AdminLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filters a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  @media (max-width: 559px) {
    .filters {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .filters a {
      justify-content: center;
      width: 100%;
    }
  }
  .status--file {
    background: #fbeeee;
    color: #9b2c2c;
  }
  .filters a[aria-current='page'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .table-wrap {
    position: relative; /* contiene el caption oculto (absoluto) dentro del desplazamiento */
    overflow-x: auto;
    padding: 0;
  }
  .table-wrap > p {
    padding: var(--space-6);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  th,
  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--color-surface-alt);
    font-weight: 600;
    white-space: nowrap;
  }
  tbody th {
    font-weight: 500;
    min-width: 16rem;
  }
  .badges {
    min-width: 7rem;
  }
  .badges .status {
    margin: 0 var(--space-1) var(--space-1) 0;
  }
  .nowrap {
    white-space: nowrap;
  }
  abbr {
    text-decoration: none;
  }
  .actions {
    white-space: nowrap;
  }
  .act + .act {
    margin-left: var(--space-3);
  }

  /* Celular y tableta: cada nota es una tarjeta con acciones grandes. */
  @media (max-width: 899px) {
    .table-wrap {
      overflow: visible;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    tbody {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: var(--space-3);
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-content: start;
      gap: var(--space-2) var(--space-4);
      padding: var(--space-4);
      background: #fff;
      border: var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }
    tbody th,
    tbody td {
      padding: 0;
      border: 0;
      min-width: 0;
    }
    tbody th a {
      display: block;
      padding-block: var(--space-2);
    }
    tbody th {
      grid-column: 1 / -1;
      font-size: var(--text-base);
      font-weight: 600;
      overflow-wrap: anywhere;
    }
    .badges {
      grid-column: 1 / -1;
      min-width: 0;
    }
    td[data-label] {
      display: grid;
      gap: 2px;
    }
    td[data-label]::before {
      content: attr(data-label);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .nowrap {
      white-space: normal;
    }
    .actions {
      grid-column: 1 / -1;
      display: flex;
      gap: var(--space-2);
      margin-top: var(--space-2);
      padding-top: var(--space-3) !important;
      border-top: var(--border) !important;
      white-space: normal;
    }
    .act {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 var(--space-3);
      border: 1px solid var(--color-primary);
      border-radius: var(--radius-sm);
      font-weight: 500;
      text-align: center;
      text-decoration: none;
    }
    .act--main {
      background: var(--color-primary);
      color: #fff;
    }
    .act + .act {
      margin-left: 0;
    }
    .table-wrap > p {
      padding: var(--space-6);
      background: #fff;
      border: var(--border);
      border-radius: var(--radius-md);
    }
  }
</style>
