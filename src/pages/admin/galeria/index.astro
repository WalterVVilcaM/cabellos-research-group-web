---
/** Panel: fotos de la Galería (ADR-015), en el mismo orden que en el sitio. */
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAdminPhotos } from '../../../utils/admin-gallery';
import { galleryFocus } from '../../../config/gallery';
import type { GalleryStatus } from '../../../utils/gallery';
import { sectionPath, withBase } from '../../../i18n/utils';

const estado = Astro.url.searchParams.get('estado');
const status: GalleryStatus | undefined = estado === 'published' || estado === 'draft' ? estado : undefined;

let photos: Awaited<ReturnType<typeof listAdminPhotos>> = [];
let loadError = false;
try {
  photos = await listAdminPhotos(status);
} catch (e) {
  console.error('Galería (panel): no se pudo leer D1', e);
  loadError = true;
}

const filters = [
  { label: 'Todas', value: undefined },
  { label: 'Publicadas', value: 'published' },
  { label: 'Sin publicar', value: 'draft' },
] as const;
const messages: Record<string, string> = {
  eliminada: 'Foto eliminada.',
};
const ok = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Galería" current="gallery">
  <div class="head">
    <div>
      <h1>Galería</h1>
      <p class="muted">Las fotos publicadas aparecen en la <a href={sectionPath('gallery', 'es')} target="_blank" rel="noopener">Galería del sitio</a>, de la más reciente a la más antigua.</p>
    </div>
    <a href={withBase('/admin/galeria/nueva/')} class="admin-btn admin-btn--primary">+ Subir foto</a>
  </div>

  {ok && messages[ok] && <p class="admin-flash" role="status">{messages[ok]}</p>}
  {
    loadError && (
      <p class="admin-flash admin-flash--error" role="alert">
        No se pudo leer la galería en este momento. Recarga la página en unos segundos; si sigue igual, avísale a Walter.
      </p>
    )
  }

  <nav aria-label="Filtrar por estado">
    <ul role="list" class="filters">
      {
        filters.map((f) => (
          <li>
            <a href={withBase(`/admin/galeria/${f.value ? `?estado=${f.value}` : ''}`)} aria-current={status === f.value ? 'page' : undefined}>
              {f.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    !loadError && photos.length === 0 ? (
      <div class="admin-card empty">
        <p>{status ? 'No hay fotos en este estado.' : 'Todavía no hay fotos en la galería.'}</p>
        <a href={withBase('/admin/galeria/nueva/')} class="admin-btn admin-btn--primary">+ Subir la primera foto</a>
      </div>
    ) : (
      <ul role="list" class="photos">
        {photos.map((p) => (
          <li class="photo admin-card">
            <a href={withBase(`/admin/galeria/${p.id}/`)} class="photo__link">
              <span class="photo__frame">
                <img src={p.thumbUrl} alt="" loading="lazy" width={p.width} height={p.height} style={`object-position:${galleryFocus[p.draft.focus].position}`} />
              </span>
              <span class="photo__body">
                <span class="photo__meta">
                  <span class={`status status--${p.draft.status}`}>{p.draft.status === 'published' ? 'Publicada' : 'Sin publicar'}</span>
                  <span>{p.draft.year}</span>
                  {p.draft.captionTr && <span class="tag" title="Tiene traducción">ES · EN</span>}
                </span>
                <strong class="photo__caption">{p.draft.caption}</strong>
                <span class="photo__edit">Editar<span class="visually-hidden">: {p.draft.caption}</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .head p {
    margin-top: var(--space-1);
  }
  @media (max-width: 559px) {
    .head .admin-btn {
      width: 100%;
      min-height: 48px;
    }
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filters a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: var(--border);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .filters a[aria-current='page'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }
  .photos {
    display: grid;
    gap: var(--space-5, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .photo {
    padding: 0;
    overflow: hidden;
  }
  .photo__link {
    display: grid;
    height: 100%;
    color: var(--color-text);
    text-decoration: none;
  }
  .photo__frame {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-alt);
  }
  .photo__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
  }
  .photo__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .tag {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .photo__caption {
    font-weight: 600;
    line-height: var(--leading-tight, 1.3);
    overflow-wrap: anywhere;
  }
  .photo__edit {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .photo__link:hover .photo__edit {
    text-decoration: underline;
  }
  .photo__link:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 3px var(--color-primary);
  }
</style>
