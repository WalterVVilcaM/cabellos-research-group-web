---
export const prerender = false; // Notes se lee de D1 en cada visita (ADR-011)
import View from '../../../../../views/NotesView.astro';
import { categoryBySlug, loadNotesListing, parsePage, notFound } from '../../../../../utils/notes';

const category = categoryBySlug(Astro.params.category ?? '', 'en');
const page = parsePage(Astro.params.page);
const data = category && page > 1 ? await loadNotesListing(page, category) : null;
if (!data || !category) return notFound(Astro.url);
---

<View lang="en" data={data} category={category} />
