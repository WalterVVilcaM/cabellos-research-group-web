---
export const prerender = false; // Notes se lee de D1 en cada visita (ADR-011)
import View from '../../views/NoteDetailView.astro';
import { loadNoteDetail, notFound } from '../../utils/notes';

const data = await loadNoteDetail(Astro.params.slug ?? '');
if (!data) return notFound(Astro.url);
---

<View lang="en" data={data} />
