---
export const prerender = false; // Notes se lee de D1 en cada visita (ADR-011)
import View from '../../../views/NotesView.astro';
import { notesListPath } from '../../../i18n/utils';
import { loadNotesListing, parsePage, notFound } from '../../../utils/notes';

const page = parsePage(Astro.params.page);
// La página 1 vive en la raíz de la sección.
if (page === 1) return Astro.redirect(notesListPath('en'), 301);
const data = await loadNotesListing(page);
if (!data) return notFound(Astro.url);
---

<View lang="en" data={data} />
