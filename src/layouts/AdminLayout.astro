---
/** Diseño del panel de Notes (solo español, sin indexar). Ver src/middleware.ts. */
import '../styles/global.css';
import { Font } from 'astro:assets';
import { withBase } from '../i18n/utils';

interface Props {
  title: string;
  current?: 'home' | 'notes' | 'new';
}
const { title, current } = Astro.props;
const email = Astro.locals.adminEmail ?? '';
const nav = [
  { key: 'home', label: 'Inicio', href: withBase('/admin/') },
  { key: 'notes', label: 'Notas', href: withBase('/admin/notas/') },
  { key: 'new', label: 'Nueva nota', href: withBase('/admin/notas/nueva/') },
] as const;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <Font cssVariable="--font-sans" preload={[{ weight: '400', style: 'normal' }]} />
    <title>{title} · Panel de Notas</title>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="admin-header">
      <div class="container admin-header__inner">
        <a href={withBase('/admin/')} class="admin-brand">Panel <span>· Notas</span></a>
        <nav aria-label="Panel">
          <ul role="list" class="admin-nav">
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="admin-user">
          <a href={withBase('/notes/')} target="_blank" rel="noopener">Ver sitio</a>
          {email && <span class="admin-user__email">{email}</span>}
          <a href="/cdn-cgi/access/logout">Salir</a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" class="container admin-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin {
    background: #f7f8f9;
  }
  .admin .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-radius: var(--radius-sm);
  }
  .admin .skip-link:focus {
    top: var(--space-2);
  }
  .admin-header {
    background: #fff;
    border-bottom: var(--border);
    border-top: 4px solid var(--color-primary);
  }
  .admin-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
    min-height: 60px;
  }
  .admin-brand {
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
  }
  .admin-brand span {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .admin-nav {
    display: flex;
    gap: var(--space-1);
  }
  .admin-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .admin-nav a:hover {
    background: var(--color-surface-alt);
  }
  .admin-nav a[aria-current='page'] {
    background: var(--color-primary);
    color: #fff;
  }
  .admin-user {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
    font-size: var(--text-sm);
  }
  .admin-user__email {
    color: var(--color-text-muted);
  }
  .admin-main {
    padding-block: var(--space-8) var(--space-16);
  }
  .admin-main > * + * {
    margin-top: var(--space-6);
  }
  .admin h1 {
    font-size: var(--text-2xl);
  }
  .admin-card {
    padding: var(--space-6);
    background: #fff;
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .admin-btn:hover {
    background: var(--color-surface-alt);
  }
  .admin-btn--primary {
    background: var(--color-primary);
    color: #fff;
  }
  .admin-btn--primary:hover {
    background: var(--color-primary-hover);
  }
  .admin-btn--danger {
    border-color: var(--color-error);
    color: var(--color-error);
  }
  .admin-flash {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-success);
    background: #eef7f0;
    border-radius: var(--radius-sm);
  }
  .admin-flash--error {
    border-color: var(--color-error);
    background: #fbeeee;
  }
  .status {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .status--published {
    background: #e3f2e8;
    color: var(--color-success);
  }
  .status--draft {
    background: #fff4e0;
    color: var(--color-warning);
  }
  .status--archived {
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
  }
  .status--test {
    background: #eef0f7;
    color: #454b73;
  }
</style>
