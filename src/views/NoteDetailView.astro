---
/**
 * Detalle de nota (VIEW-007-D). Ficha: docs/views/VIEW-007-D-note.md.
 * El contenido está en el idioma de la nota; la interfaz, en `lang` (ADR-009).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Tag from '../components/ui/Tag.astro';
import Icon from '../components/ui/Icon.astro';
import NoteLinks from '../components/content/NoteLinks.astro';
import AttachmentList from '../components/content/AttachmentList.astro';
import { site } from '../config/site';
import { noteCategories } from '../config/notes';
import { useTranslations, sectionPath, notesListPath, notePath, researchPath, type Lang } from '../i18n/utils';
import { getResearch } from '../utils/content';
import { noteUrls, categoryPath, authorPath, formatNoteDate, isoDate, type NoteDetail } from '../utils/notes';

interface Props {
  lang: Lang;
  data: NoteDetail;
}
const { lang, data } = Astro.props;
const { note, older, newer } = data;
const t = useTranslations(lang);
const tc = useTranslations(note.lang);

const research = await getResearch();
const urls = noteUrls(note, data.translation);
const otherLang = note.lang !== lang;
const contentLang = otherLang ? note.lang : undefined;
const lines = research.filter((r) => note.researchAreas.includes(r.id));

const base = Astro.site ?? new URL(site.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: note.title,
  description: note.summary,
  inLanguage: note.lang,
  datePublished: isoDate(note.publishedAt),
  ...(note.updatedAt && { dateModified: isoDate(note.updatedAt) }),
  author: { '@type': 'Person', name: note.author.fullName, url: new URL(authorPath(note, note.lang), base).href },
  publisher: { '@type': 'Organization', name: site.brand },
  mainEntityOfPage: new URL(urls.canonical, base).href,
  ...(note.tags.length > 0 && { keywords: note.tags.join(', ') }),
};
---

<BaseLayout
  lang={lang}
  title={note.title}
  description={note.summary}
  alternates={urls.alternatesFrom(lang)}
  current="notes"
  ogType="article"
  canonicalPath={urls.canonical}
  hreflang={urls.hreflang}
  ogLocale={tc('meta.ogLocale')}
  jsonLd={note.isTest ? undefined : jsonLd}
  noindex={note.isTest}
>
  <article>
    <header class="note-header">
      <div class="container">
        <Breadcrumb
          lang={lang}
          items={[
            { label: t('nav.home'), href: sectionPath('home', lang) },
            { label: t('notes.title'), href: notesListPath(lang) },
            { label: note.title },
          ]}
        />
        <div class="note-header__body">
          <p class="note-labels">
            <a href={categoryPath(note.category, lang)} class="note-cat">{noteCategories[note.category].name[lang]}</a>
            {
              otherLang && (
                <span class="note-lang" lang={note.lang}>
                  <span aria-hidden="true">{note.lang.toUpperCase()}</span>
                  <span class="visually-hidden">{t(`notes.langLabel.${note.lang}`)}</span>
                </span>
              )
            }
            {note.isTest && <span class="note-test">{t('notes.test')}</span>}
          </p>
          <h1 lang={contentLang}>{note.title}</h1>
          <p class="note-summary" lang={contentLang}>{note.summary}</p>
          <p class="note-meta">
            <a href={authorPath(note, lang)}>{note.author.fullName}</a>
            <span aria-hidden="true">·</span>
            <time datetime={isoDate(note.publishedAt)}>{formatNoteDate(note.publishedAt, lang)}</time>
            {
              note.updatedAt && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    {t('notes.updated', { date: '' }).trim()}{' '}
                    <time datetime={isoDate(note.updatedAt)}>{formatNoteDate(note.updatedAt, lang)}</time>
                  </span>
                </>
              )
            }
          </p>
          {note.isTest && <p class="note-test-notice">{t('notes.testNotice')}</p>}
        </div>
      </div>
    </header>

    <div class="section note-section">
      <div class="container note-layout">
        {
          note.cover && (
            <figure class="note-cover">
              <img src={note.cover.url} alt={note.cover.alt} loading="eager" decoding="async" />
            </figure>
          )
        }

        <div class="prose note-body" lang={contentLang}>
          <Fragment set:html={note.html} />
        </div>

        {
          note.links.length > 0 && (
            <section aria-labelledby="note-links" class="note-block">
              <h2 id="note-links" class="block-title">{t('notes.links')}</h2>
              <NoteLinks items={note.links} lang={lang} contentLang={note.lang} />
            </section>
          )
        }

        {
          note.attachments.length > 0 && (
            <section aria-labelledby="note-files" class="note-block">
              <h2 id="note-files" class="block-title">{t('notes.files')}</h2>
              <AttachmentList items={note.attachments} lang={lang} />
            </section>
          )
        }

        {
          (note.tags.length > 0 || lines.length > 0) && (
            <div class="note-block note-tax">
              {note.tags.length > 0 && (
                <section aria-labelledby="note-tags">
                  <h2 id="note-tags" class="block-title">{t('notes.tags')}</h2>
                  <ul role="list" class="tags">
                    {note.tags.map((tag) => (
                      <li>
                        <Tag>{tag}</Tag>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
              {lines.length > 0 && (
                <section aria-labelledby="note-lines">
                  <h2 id="note-lines" class="block-title">{t('notes.research')}</h2>
                  <ul role="list" class="tags">
                    {lines.map((r) => (
                      <li>
                        <Tag href={researchPath(r.data.slug, lang)}>{r.data.shortTitle[lang]}</Tag>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )
        }
      </div>
    </div>
  </article>

  <nav class="section section--alt note-nav" aria-label={t('notes.more')}>
    <div class="container note-nav__inner">
      {
        older ? (
          <a href={notePath(older.slug, lang)} class="note-nav__link" rel="prev">
            <span class="note-nav__dir">
              <Icon name="arrow-left" size={16} />
              {t('notes.prev')}
            </span>
            <span class="note-nav__title" lang={older.lang !== lang ? older.lang : undefined}>{older.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a href={notesListPath(lang)} class="note-nav__all">{t('notes.allNotes')}</a>
      {
        newer ? (
          <a href={notePath(newer.slug, lang)} class="note-nav__link note-nav__link--next" rel="next">
            <span class="note-nav__dir">
              {t('notes.next')}
              <Icon name="arrow-right" size={16} />
            </span>
            <span class="note-nav__title" lang={newer.lang !== lang ? newer.lang : undefined}>{newer.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </div>
  </nav>
</BaseLayout>

<style>
  .note-header {
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 4vw, 2.5rem);
    border-top: 4px solid var(--color-primary);
    border-bottom: var(--border);
    background: var(--color-bg);
  }
  .note-header__body {
    max-width: 46rem;
    margin-top: var(--space-8);
  }
  .note-header__body > * + * {
    margin-top: var(--space-4);
  }
  .note-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .note-cat {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }
  .note-cat:hover {
    text-decoration: underline;
  }
  .note-lang,
  .note-test {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
  }
  .note-lang {
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .note-test {
    background: #fff4e0;
    color: var(--color-warning);
    text-transform: uppercase;
  }
  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .note-summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .note-test-notice {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-warning);
    background: #fff9ef;
    font-size: var(--text-sm);
    color: var(--color-warning);
  }
  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    justify-items: start;
  }
  .note-layout > * {
    width: 100%;
    min-width: 0;
    max-width: 46rem;
  }
  .note-section {
    padding-top: var(--space-12);
  }
  .note-nav {
    padding-block: var(--space-12);
  }
  .note-cover {
    max-width: 48rem;
  }
  .note-cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .note-body {
    max-width: 46rem;
    font-size: var(--text-lg);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .note-body :global(h2) {
    font-size: var(--text-2xl);
  }
  .note-body :global(h4) {
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }
  .note-body :global(blockquote) {
    padding-left: var(--space-6);
    border-left: 4px solid var(--color-accent-deco);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .note-body :global(hr) {
    border: 0;
    border-top: var(--border);
    margin-block: var(--space-8);
  }
  .note-body :global(.table-wrap) {
    max-width: 100%;
    overflow-x: auto;
  }
  .note-body :global(table) {
    border-collapse: collapse;
    font-size: var(--text-base);
  }
  .note-body :global(th),
  .note-body :global(td) {
    padding: var(--space-2) var(--space-4);
    border: var(--border);
    text-align: left;
  }
  .note-body :global(th) {
    background: var(--color-surface-alt);
    font-weight: 600;
  }
  .note-body :global(code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    font-size: 0.9em;
  }
  .note-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .block-title {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .note-block {
    padding-top: var(--space-8);
    border-top: var(--border);
  }
  .note-tax {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 640px) {
    .note-tax {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .note-nav__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 800px) {
    .note-nav__inner {
      grid-template-columns: 1fr auto 1fr;
    }
  }
  .note-nav__link {
    display: grid;
    gap: var(--space-1);
    max-width: 32ch;
    text-decoration: none;
  }
  .note-nav__link--next {
    justify-self: end;
    text-align: right;
  }
  .note-nav__link--next .note-nav__dir {
    justify-content: flex-end;
  }
  @media (max-width: 799.98px) {
    .note-nav__link--next {
      justify-self: start;
      text-align: left;
    }
    .note-nav__link--next .note-nav__dir {
      justify-content: flex-start;
    }
  }
  .note-nav__dir {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .note-nav__title {
    font-weight: 600;
    color: var(--color-text);
  }
  .note-nav__link:hover .note-nav__title {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .note-nav__all {
    font-weight: 500;
  }
</style>
