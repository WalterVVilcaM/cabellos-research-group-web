---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PublicationItem from '../components/content/PublicationItem.astro';
import { useTranslations, sectionAlternates, type Lang } from '../i18n/utils';
import {
  getPublications,
  getMembers,
  groupByYear,
  getStats,
} from '../utils/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [pubs, members, stats] = await Promise.all([
  getPublications(),
  getMembers(),
  getStats(),
]);
const years = groupByYear(pubs);
const highlight = members.flatMap((m) => [m.data.name, ...m.data.citationNames]);
const journalCounts = [...pubs.reduce((m, p) => m.set(p.data.journal, (m.get(p.data.journal) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  lang={lang}
  title={t('pubs.title')}
  description={t('pubs.description')}
  alternates={sectionAlternates('publications')}
  current="publications"
>
  <PageHeader
    lang={lang}
    title={t('pubs.title')}
    lead={pubs.length ? t('pubs.lead', { n: stats.publications, from: stats.from ?? '', to: stats.to ?? '' }) : undefined}
  />

  {
    pubs.length === 0 ? (
      <div class="section">
        <p class="container muted">{t('pubs.empty')}</p>
      </div>
    ) : (
      <>
        <div class="index">
          <div class="container index__grid">
            <nav aria-labelledby="by-year">
              <h2 id="by-year" class="index__title">{t('pubs.byYear')}</h2>
              <ul role="list" class="chips">
                {years.map(([year, items]) => (
                  <li>
                    <a href={`#y${year}`} class="chip">
                      {year} <span class="chip__n">{items.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>

        <div class="section">
          <div class="container years">
            {years.map(([year, items]) => (
              <section aria-labelledby={`y${year}`} class="year" data-year-group>
                <h2 id={`y${year}`} class="year__title">{year}</h2>
                <ul role="list">
                  {items.map((p) => (
                    <PublicationItem pub={p} lang={lang} highlight={highlight} />
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
        <section class="section section--alt journals" aria-labelledby="journals-title">
          <div class="container">
            <h2 id="journals-title" class="accent-title">{t('about.journalsTitle')}</h2>
            <p class="journals__intro">{t('about.journalsIntro', { n: stats.publications, j: journalCounts.length, from: stats.from ?? '', to: stats.to ?? '' })}</p>
            <ul role="list" class="jgrid">
              {journalCounts.map(([name, n], i) => (
                <li class:list={['jtile', { 'jtile--top': n > 1 }]} data-reveal style={`--i: ${i % 6}`}>
                  <span class="jtile__n">{n}</span>
                  <span class="jtile__body">
                    <span class="jtile__name" lang="en">{name}</span>
                    <span class="jtile__count">{n === 1 ? t('about.paperOne') : t('about.paperMany')}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>

<style>
  .index {
    padding-block: var(--space-8);
    border-bottom: var(--border);
    background: var(--color-surface);
  }
  .index__grid {
    display: grid;
    gap: var(--space-8);
  }
  .index__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 4rem;
    min-height: 40px;
    padding: 0 var(--space-3);
    border: var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .chip__n {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .chip:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-alt);
  }
  .years {
    display: grid;
    gap: var(--space-12);
  }
  .year {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .year {
      grid-template-columns: 8rem 1fr;
      gap: var(--space-8);
    }
    .year__title {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      align-self: start;
    }
  }
  .year__title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-2xl);
    color: var(--color-accent);
    letter-spacing: 0;
  }
  .journals__intro {
    max-width: 60ch;
    margin: var(--space-2) 0 var(--space-8);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .jgrid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .jtile {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.5rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .jtile:hover {
    border-color: var(--color-accent-deco);
    box-shadow: var(--shadow-sm);
  }
  .jtile__n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    color: var(--color-primary);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .jtile--top .jtile__n {
    background: var(--color-primary);
    color: #fff;
  }
  .jtile__body {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }
  .jtile__name {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .jtile__count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
