---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PhotoCarousel from '../components/ui/PhotoCarousel.astro';
import RichText from '../components/ui/RichText.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';
import { heroGallery } from '../config/gallery';
import { useTranslations, sectionPath, sectionAlternates, researchPath, memberPath, type Lang } from '../i18n/utils';
import { getResearch, getPublications, getMembers, getStats, shortAuthors } from '../utils/content';
import ExternalLink from '../components/ui/ExternalLink.astro';
import ctaPhoto from '../assets/gallery/campus-explanada.webp';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const [research, pubs, members, stats] = await Promise.all([getResearch(), getPublications(), getMembers(), getStats()]);
const pi = members.find((m) => m.data.role === 'pi');
const pubById = new Map(pubs.map((p) => [p.id, p]));
const recent = pubs.slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
const journals = new Set(pubs.map((p) => p.data.journal)).size;
const statItems = [
  { value: stats.publications, label: t('about.statPapers') },
  { value: journals, label: t('about.statJournals') },
  { value: stats.coauthors, label: t('about.statCoauthors') },
  { value: stats.activeYears, label: t('about.statYears'), note: stats.from && stats.to ? `${stats.from}–${stats.to}` : '' },
].filter((s) => s.value > 0);
---

<BaseLayout lang={lang} title={t('home.title')} description={t('home.description')} alternates={sectionAlternates('home')} current="home">
  <section class="hero" aria-labelledby="intro-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{site.institution.name}</p>
        <h1 id="intro-title">{site.brand}</h1>
        <p class="hero__lead"><strong>{site.descriptiveName[lang]}.</strong>{' '}{t('home.purpose')}</p>
        <div class="hero__actions">
          <Button href={sectionPath('research', lang)} arrow>{t('home.ctaResearch')}</Button>
          <Button href={sectionPath('publications', lang)} variant="secondary">{t('home.ctaPublications')}</Button>
        </div>
      </div>
      <div class="hero__media">
        {heroGallery.length > 0 && (
          <div class="hero__frame">
            <PhotoCarousel photos={heroGallery} lang={lang} label={t('carousel.heroLabel')} interval={6000} class="hero__photos" />
          </div>
        )}
        {pi && (
          <a class="pi-chip" href={memberPath(pi.id, lang)}>
            {pi.data.photo && (
              <Image src={pi.data.photo} alt="" width={56} height={56} widths={[56, 112]} sizes="56px" class="pi-chip__img" />
            )}
            <span class="pi-chip__body">
              <span class="pi-chip__name">{[pi.data.academicTitle, pi.data.name].filter(Boolean).join(' ')}</span>
              <span class="pi-chip__role">{pi.data.position[lang]}{pi.data.distinctions[0] && <> · {pi.data.distinctions[0][lang].replace(/^.*\((SNII)\),?\s*/, '$1 ')}</>}</span>
            </span>
            <Icon name="arrow-right" size={18} />
          </a>
        )}
      </div>
    </div>
  </section>

  {statItems.length > 0 && (
    <div class="container stats-wrap">
      <dl class="stats">
        {statItems.map((st, i) => (
          <div class="stat" data-reveal style={`--i: ${i}`}>
            <dt>{st.label}{st.note && <span class="stat__note"> · {st.note}</span>}</dt>
            <dd data-count={st.value}>{st.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}

  <section class="section who" aria-labelledby="who-title">
    <div class="container who__grid">
      <div class="who__text">
        <h2 id="who-title" class="accent-title">{t('about.whoTitle')}</h2>
        <p class="who__first">{t('about.who.1')}</p>
        <p>{t('about.who.2')}</p>
        <p>{t('about.who.3')}</p>
      </div>
      <div class="who__side">
        <figure class="question" data-reveal>
          <figcaption>{t('about.questionLabel')}</figcaption>
          <blockquote><p>{t('about.question')}</p></blockquote>
        </figure>
        <dl class="facts" data-reveal style="--i: 1">
          <div>
            <dt><Icon name="building" size={18} /> {t('about.factInstitution')}</dt>
            <dd><ExternalLink href={site.institution.url} lang={lang}>{site.institution.name}</ExternalLink></dd>
          </div>
          <div>
            <dt><Icon name="pin" size={18} /> {t('about.factPlace')}</dt>
            <dd>{t('about.factPlaceValue')}</dd>
          </div>
          <div>
            <dt><Icon name="cpu" size={18} /> {t('about.factComputing')}</dt>
            <dd>{t('about.factComputingValue')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section areas" aria-labelledby="lines-title">
    <div class="container">
      <SectionHeader id="lines-title" title={t('home.researchTitle')} intro={t('home.researchIntro')}>
        <Button slot="action" href={sectionPath('research', lang)} variant="ghost" arrow>{t('nav.research')}</Button>
      </SectionHeader>
      <ol role="list" class="areas__grid">
        {research.map((r, i) => {
          const src = r.data.cover ? pubById.get(r.data.cover.source.id) : undefined;
          return (
            <li data-reveal style={`--i: ${i}`}>
              <article class="area" data-line={r.data.order}>
                <div class="area__fig">
                  {r.data.cover && (
                    <Image src={r.data.cover.image} alt="" widths={[320, 640]} sizes="(min-width: 900px) 240px, 40vw" />
                  )}
                </div>
                <div class="area__body">
                  <span class="area__num" aria-hidden="true">{pad(r.data.order)}</span>
                  <h3 class="area__title"><a href={researchPath(r.data.slug, lang)}>{r.data.title[lang]}</a></h3>
                  <p class="area__summary">{r.data.summary[lang]}</p>
                  {src && (
                    <p class="area__credit">{t('home.figure')}: {shortAuthors(src.data.authors)}, <i>{src.data.journal}</i> ({src.data.year}) · <span class="nowrap">{r.data.cover!.license}</span></p>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="section section--alt recent" aria-labelledby="pubs-title">
      <div class="container">
        <SectionHeader
          id="pubs-title"
          title={t('home.pubsTitle')}
          intro={t('home.pubsIntro', { n: stats.publications, from: stats.from ?? '', to: stats.to ?? '' })}
        >
          <Button slot="action" href={sectionPath('publications', lang)} variant="ghost" arrow>{t('home.pubsAll')}</Button>
        </SectionHeader>
        <ul role="list" class="recent__list">
          {recent.map((p) => {
            const href = p.data.doi ? `https://doi.org/${p.data.doi}` : p.data.url;
            return (
              <li class="rpub">
                <p class="rpub__meta"><span class="rpub__journal">{p.data.journal}</span> · {p.data.year}</p>
                <p class="rpub__title" lang="en">
                  {href ? <a href={href} target="_blank" rel="noopener noreferrer"><RichText text={p.data.title} /><span class="visually-hidden"> {t('a11y.external')}</span></a> : <RichText text={p.data.title} />}
                </p>
                <p class="rpub__authors">{shortAuthors(p.data.authors)}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="section cta-wrap" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta" data-reveal>
        <Image src={ctaPhoto} alt="" widths={[800, 1200]} sizes="(min-width: 1200px) 1150px, 100vw" class="cta__img" />
        <div class="cta__body">
          <h2 id="cta-title">{t('about.ctaTitle')}</h2>
          <p>{t('about.ctaText')}</p>
          <div class="cta__actions">
            <Button href={sectionPath('contact', lang)} variant="on-ink" arrow>{t('nav.contact')}</Button>
            <a class="cta__ghost" href={sectionPath('team', lang)}>{t('nav.team')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.5rem);
    align-items: center;
  }
  .hero__text > * + * {
    margin-top: var(--space-4);
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.7rem + 2.6vw, 3.6rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .hero__lead {
    max-width: 44ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .hero__lead strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  .hero__media {
    position: relative;
    min-width: 0;
  }
  /* Bloque verde desplazado detrás de la foto: da profundidad sin adornos */
  .hero__frame {
    position: relative;
    isolation: isolate;
  }
  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 1.5rem -0.75rem -0.75rem 1.5rem;
    z-index: -1;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
  }
  .hero :global(.hero__photos) {
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
    .hero__frame::before {
      inset: 2.25rem -1.5rem -1.5rem 2.25rem;
    }
    .hero :global(.hero__photos .pc__stage) {
      aspect-ratio: auto;
      height: clamp(420px, 60vh, 580px);
    }
  }

  /* Tarjeta flotante del investigador principal */
  .pi-chip {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    max-width: 100%;
    margin: var(--space-6) auto 0 0;
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    text-decoration: none;
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .pi-chip:hover {
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  .pi-chip :global(.icon) {
    flex: none;
    color: var(--color-primary);
  }
  .pi-chip :global(.pi-chip__img) {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .pi-chip__body {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }
  .pi-chip__name {
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .pi-chip__role {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .pi-chip {
      position: absolute;
      top: 1.5rem;
      left: -2.5rem;
      margin: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pi-chip:hover {
      transform: none;
    }
  }

  /* ---------- Líneas: tarjetas con figura publicada ---------- */
  .areas__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 900px) {
    .areas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .areas__grid > li {
    min-width: 0;
  }
  .area {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(16 24 20 / 0.06);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .area:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .area:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  @media (max-width: 560px) {
    .area {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .area__fig {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    border-right: var(--border);
    background: #fff;
  }
  @media (max-width: 560px) {
    .area__fig {
      aspect-ratio: 16 / 9;
      border-right: 0;
      border-bottom: var(--border);
    }
  }
  .area__fig :global(img) {
    width: 100%;
    height: 100%;
    max-height: 200px;
    object-fit: contain;
    transition: transform 500ms var(--ease);
  }
  .area:hover .area__fig :global(img) {
    transform: scale(1.04);
  }
  .area__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .area__num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--line-bg);
    color: var(--line-fg);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .area__title {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }
  .area__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .area__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .area__title a:focus-visible {
    outline: none;
  }
  .area:hover .area__title a {
    color: var(--line-ink);
  }
  .area__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .nowrap {
    white-space: nowrap;
  }
  .area__credit {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .area:hover,
    .area:hover .area__fig :global(img) {
      transform: none;
    }
  }

  /* ---------- Publicaciones recientes ---------- */
  .recent__list {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 900px) {
    .recent__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .rpub {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 3px solid var(--color-primary);
  }
  .rpub__meta {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .rpub__title {
    font-weight: 600;
    line-height: 1.35;
  }
  .rpub__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .rpub__title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .rpub__authors {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  /* ---------- Cifras ---------- */
  .stats-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * clamp(1rem, 3vw, 2rem));
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgb(16 24 20 / 0.06);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 800px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 2rem);
    border-right: var(--border);
    border-bottom: var(--border);
  }
  .stat dd {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .stat dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .stat__note {
    white-space: nowrap;
  }
  @media (min-width: 800px) {
    .stat {
      border-bottom: 0;
    }
    .stat:last-child {
      border-right: 0;
    }
  }
  @media (max-width: 799.98px) {
    .stat:nth-child(2n) {
      border-right: 0;
    }
    .stat:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  /* ---------- Quiénes somos ---------- */
  .who__grid {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }
  @media (min-width: 960px) {
    .who__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
  }
  .who__text {
    max-width: var(--measure);
  }
  .who__text > * + * {
    margin-top: var(--space-4);
  }
  .who__text h2 {
    margin-bottom: var(--space-6);
  }
  .who__text p {
    color: var(--color-text-muted);
  }
  .who__text .who__first {
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .who__side {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 960px) {
    .who__side {
      padding-top: 4.25rem;
    }
  }
  .question {
    margin: 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    border-left: 4px solid var(--color-primary);
  }
  .question figcaption {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .question blockquote {
    margin: var(--space-2) 0 0;
  }
  .question blockquote p {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .facts {
    display: grid;
    padding: var(--space-2) var(--space-6);
    border: 1px solid rgb(16 24 20 / 0.06);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .facts > div {
    display: grid;
    gap: 0.15rem;
    padding-block: var(--space-3);
    border-bottom: var(--border);
  }
  .facts > div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .facts dt :global(.icon) {
    color: var(--color-primary);
  }
  .facts dd {
    padding-left: calc(18px + var(--space-2));
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .areas {
    padding-top: 0;
  }

  /* ---------- Invitación ---------- */
  .cta-wrap {
    padding-top: 0;
  }
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-on-ink);
    box-shadow: var(--shadow-lg);
  }
  .cta :global(.cta__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    opacity: 0.35;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(9 33 25 / 0.95) 0%, rgb(9 33 25 / 0.8) 50%, rgb(9 33 25 / 0.45) 100%);
  }
  .cta__body {
    max-width: 44rem;
    padding: clamp(2rem, 6vw, 4rem);
  }
  .cta h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    color: #fff;
    letter-spacing: -0.02em;
  }
  .cta p {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: rgb(255 255 255 / 0.85);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-8);
  }
  .cta__ghost {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-6);
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: var(--radius-sm);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--duration) var(--ease);
  }
  .cta__ghost:hover {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }
</style>
