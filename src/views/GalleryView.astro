---
/**
 * Galería (VIEW-008). Cuadrícula de fotos con pie (lugar, año, crédito y licencia).
 * Al hacer clic, la foto se abre en grande en un <dialog>; sin JavaScript, el enlace abre la imagen.
 * Las fotos se administran desde el panel (/admin/galeria/) y se leen de D1 en cada visita (ADR-015):
 * la página recibe `photos` ya normalizadas (src/utils/gallery.ts → loadGallery).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import type { GalleryItem } from '../utils/gallery';
import { useTranslations, sectionAlternates, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  photos: GalleryItem[];
}
const { lang, photos } = Astro.props;
const t = useTranslations(lang);
const many = photos.length > 4;
/** Atributo lang solo cuando el texto está en el otro idioma (falta la traducción). */
const langAttr = (l: Lang) => (l === lang ? undefined : l);
---

<BaseLayout
  lang={lang}
  title={t('gallery.title')}
  description={t('gallery.description')}
  alternates={sectionAlternates('gallery')}
  current="gallery"
>
  <PageHeader lang={lang} title={t('gallery.title')} lead={t('gallery.lead')} />

  <div class="section">
    <div class="container">
      {
        photos.length === 0 ? (
          <p class="empty muted">{t('gallery.empty')}</p>
        ) : (
          <ul class="grid" role="list" data-many={many ? '' : undefined}>
            {photos.map((p, i) => (
              <li>
                <figure class="card">
                  <a
                    class="frame"
                    href={p.full.url}
                    data-lightbox={i}
                    data-full={p.full.url}
                    data-alt={p.alt.text}
                    data-caption={`${p.caption.text} · ${p.place ? `${p.place.text}, ` : ''}${p.year}`}
                    aria-label={`${t('gallery.enlarge')}: ${p.caption.text}`}
                  >
                    <img
                      src={p.thumb.url}
                      srcset={p.full.width > p.thumb.width ? `${p.thumb.url} ${p.thumb.width}w, ${p.full.url} ${p.full.width}w` : undefined}
                      sizes={many ? '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw' : '(min-width: 700px) 50vw, 100vw'}
                      alt={p.alt.text}
                      lang={langAttr(p.alt.lang)}
                      width={p.width}
                      height={p.height}
                      style={`object-position: ${p.objectPosition}`}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </a>
                  <figcaption>
                    <span class="meta">
                      {p.place && <span lang={langAttr(p.place.lang)}>{p.place.text} · </span>}
                      {p.year}
                    </span>
                    <span class="title" lang={langAttr(p.caption.lang)}>{p.caption.text}</span>
                    <span class="credit">
                      {t('gallery.photo')}: {p.credit}
                      {p.license && (
                        <>
                          {' · '}
                          <ExternalLink href={p.license.url} lang={lang}>
                            {p.license.name}
                          </ExternalLink>
                        </>
                      )}
                      {p.sourceUrl && (
                        <>
                          {' · '}
                          <ExternalLink href={p.sourceUrl} lang={lang}>
                            {t('gallery.source')}
                          </ExternalLink>
                        </>
                      )}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label={t('gallery.viewer')}>
    <form method="dialog" class="lb-close-form">
      <button class="lb-close" type="submit" aria-label={t('gallery.close')}>×</button>
    </form>
    <img data-lb-img alt="" />
    <p class="lb-caption" data-lb-caption></p>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const img = dialog?.querySelector<HTMLImageElement>('[data-lb-img]');
  const caption = dialog?.querySelector<HTMLElement>('[data-lb-caption]');
  if (dialog && img && caption && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        img.src = a.dataset.full ?? a.href;
        img.alt = a.dataset.alt ?? '';
        caption.textContent = a.dataset.caption ?? '';
        dialog.showModal();
      });
    });
    // Clic fuera de la imagen cierra el visor.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .empty {
    max-width: 60ch;
    padding: var(--space-8);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Tres columnas solo cuando haya suficientes fotos para llenar filas. */
  @media (min-width: 1100px) {
    .grid[data-many] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transition: none;
      transform: none;
    }
  }

  .frame {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-alt);
    cursor: zoom-in;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration) var(--ease);
  }
  .frame:hover :global(img) {
    transform: scale(1.03);
  }
  .frame:focus-visible {
    outline: none;
    box-shadow: inset var(--shadow-focus);
  }

  figcaption {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6) var(--space-6);
  }
  .meta {
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .title {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .credit :global(a) {
    white-space: nowrap;
  }
  .credit {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lightbox {
    margin: auto;
    width: min(96vw, 1200px);
    max-height: 94vh;
    padding: var(--space-4);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-on-ink);
    box-shadow: var(--shadow-lg);
  }
  .lightbox::backdrop {
    background: rgb(10 18 15 / 0.82);
  }
  .lightbox img {
    display: block;
    width: 100%;
    max-height: calc(94vh - 7rem);
    object-fit: contain;
  }
  .lb-close-form {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 var(--space-2);
  }
  .lb-close {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-on-ink);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-close:hover,
  .lb-close:focus-visible {
    background: rgb(255 255 255 / 0.12);
  }
  .lb-caption {
    margin: var(--space-3) 0 0;
    color: var(--color-on-ink-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
